generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}
enum TaskStatus {
  BACKLOG
  READY
  RUNNING
  REVIEW
  DONE
  BLOCKED
}
enum RunStatus {
  QUEUED
  RUNNING
  AWAITING_APPROVAL
  SUCCEEDED
  FAILED
  CANCELLED
}
enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}
enum LearningStatus {
  PENDING
  APPROVED
  REJECTED
  NEEDS_EDIT
}

model User {
  id String @id @default(cuid())
  email String @unique
  name String
  passwordHash String
  memberships Membership[]
  createdAt DateTime @default(now())
}
model Company {
  id String @id @default(cuid())
  name String
  slug String @unique
  description String?
  departments Json @default("[]")
  onboardingCompletedAt DateTime?
  memberships Membership[]
  projects Project[]
  providers ProviderConnection[]
  tasks Task[]
  memories MemoryEntry[]
  documents KnowledgeDocument[]
  knowledgeChunks KnowledgeChunk[]
  learnings LearningPoint[]
  chatTranscripts ChatTranscript[]
  approvals Approval[]
  auditLogs AuditLog[]
  runs AgentRun[]
  createdAt DateTime @default(now())
}
model Membership {
  id String @id @default(cuid())
  userId String
  companyId String
  role Role @default(MEMBER)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  @@unique([userId, companyId])
}
model Project {
  id String @id @default(cuid())
  companyId String
  name String
  slug String
  description String?
  repositoryUrl String?
  defaultBranch String @default("main")
  agentsMd String @default("")
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  tasks Task[]
  memories MemoryEntry[]
  documents KnowledgeDocument[]
  knowledgeChunks KnowledgeChunk[]
  learnings LearningPoint[]
  chatTranscripts ChatTranscript[]
  createdAt DateTime @default(now())
  @@unique([companyId, slug])
}
model ProviderConnection {
  id String @id @default(cuid())
  companyId String
  kind String
  label String
  encryptedSecret String?
  status String @default("configured")
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@unique([companyId, kind, label])
}
model Task {
  id String @id @default(cuid())
  companyId String
  projectId String?
  departmentId String?
  title String
  spec String
  priority String @default("medium")
  status TaskStatus @default(BACKLOG)
  providerKind String @default("mock")
  budgetUsd Decimal @default(5)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  runs AgentRun[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([companyId, departmentId])
}
model AgentRun {
  id String @id @default(cuid())
  companyId String
  taskId String
  providerKind String
  status RunStatus @default(QUEUED)
  plan Json?
  logs Json @default("[]")
  costUsd Decimal @default(0)
  branchName String?
  pullRequestUrl String?
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  approval Approval?
  createdAt DateTime @default(now())
  finishedAt DateTime?
}
model MemoryEntry {
  id String @id @default(cuid())
  companyId String
  projectId String?
  kind String
  title String
  content String
  version Int @default(1)
  authorId String?
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  revisions MemoryRevision[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([companyId, projectId])
}
model MemoryRevision {
  id String @id @default(cuid())
  memoryId String
  version Int
  content String
  authorId String?
  memory MemoryEntry @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@unique([memoryId, version])
}
model KnowledgeDocument {
  id String @id @default(cuid())
  companyId String
  projectId String?
  name String
  mimeType String
  size Int
  sha256 String
  fileData Bytes
  extractedText String
  preview String
  chunkCount Int
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  chunks KnowledgeChunk[]
  createdAt DateTime @default(now())
  @@index([companyId, projectId])
}
model KnowledgeChunk {
  id String @id @default(cuid())
  companyId String
  projectId String?
  documentId String
  ordinal Int
  content String
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  document KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  @@unique([documentId, ordinal])
  @@index([companyId, projectId])
}
model LearningPoint {
  id String @id @default(cuid())
  companyId String
  projectId String?
  sourceType String
  sourceId String
  sourceLabel String
  statement String
  sourceExcerpt String
  status LearningStatus @default(PENDING)
  reviewNote String?
  reviewedById String?
  reviewedAt DateTime?
  version Int @default(1)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  revisions LearningRevision[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([companyId, projectId, status])
  @@unique([companyId, sourceType, sourceId, statement])
}
model LearningRevision {
  id String @id @default(cuid())
  learningId String
  version Int
  statement String
  status LearningStatus
  reviewNote String?
  actorId String?
  learning LearningPoint @relation(fields: [learningId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@unique([learningId, version])
}
model ChatTranscript {
  id String @id @default(cuid())
  companyId String
  projectId String?
  title String
  content String
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  @@index([companyId, projectId])
}
model Approval {
  id String @id @default(cuid())
  companyId String
  runId String @unique
  type String
  summary String
  status ApprovalStatus @default(PENDING)
  decidedById String?
  decidedAt DateTime?
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  run AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}
model AuditLog {
  id String @id @default(cuid())
  companyId String
  actorId String?
  action String
  entityType String
  entityId String
  detail Json?
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@index([companyId, createdAt])
}
